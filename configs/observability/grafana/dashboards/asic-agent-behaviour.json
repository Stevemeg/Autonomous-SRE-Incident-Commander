{
  "uid": "asic-agent-behaviour",
  "title": "ASIC / Agent behaviour",
  "description": "Planning, termination mix, budgets, schema violations and reflection.",
  "tags": [
    "asic"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Node duration p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(asic_node_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{node}}"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Planning iterations per run (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(asic_investigation_iterations_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(asic_investigation_iterations_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Runs terminated by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
