      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "sum by (status, risk_tier) (increase(asic_remediation_action_transitions_total[$__rate_interval]))",
          "legendFormat": "{{risk_tier}} {{status}}"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
