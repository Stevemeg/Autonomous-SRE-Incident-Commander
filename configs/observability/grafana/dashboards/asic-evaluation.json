{
  "uid": "asic-evaluation",
  "title": "ASIC / Evaluation",
  "description": "Suite gate outcomes and per-scenario verdicts as committed by the evaluation gate. Simulator and replay runs validate the pipeline, not reasoning quality.",
  "tags": [
    "asic"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Suite runs not passing (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "sum(increase(asic_evaluation_suite_runs_total{gate_status!=\"passed\"}[7d]))"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Contested results (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "sum(increase(asic_evaluation_results_total{verdict=\"contested\"}[7d]))"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Suite runs by gate status",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "sum by (suite, mode, gate_status) (increase(asic_evaluation_suite_runs_total[$__rate_interval]))",
          "legendFormat": "{{suite}} {{mode}} {{gate_status}}"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Scenario verdicts",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "sum by (mode, verdict) (increase(asic_evaluation_results_total[$__rate_interval]))",
          "legendFormat": "{{mode}} {{verdict}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Judge results by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "asic-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "asic-prometheus"
          },
          "expr": "sum by (outcome) (increase(asic_evaluation_judge_results_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    }
  ]
}
