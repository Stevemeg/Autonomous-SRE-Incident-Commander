# Normalize line endings in the repository to LF regardless of contributor platform.
# Without this, a Windows checkout commits CRLF and every cross-platform diff becomes
# noise. Working-copy endings are still native; only the stored form is pinned.
* text=auto eol=lf

# Shell scripts must be LF even on Windows checkouts or they fail in containers/CI.
*.sh   text eol=lf
*.bash text eol=lf

# Windows-native scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never apply line-ending or text conversion. Office documents are ZIP
# containers and are corrupted by newline translation.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.zip  binary
*.gz   binary
*.woff  binary
*.woff2 binary
*.ttf  binary

# Treat the authoritative specification as binary and exclude it from diff noise;
# review its verified Markdown transcription instead.
docs/spec/*.docx binary -diff

# Lockfiles are generated: collapse them in diffs and mark them in review.
package-lock.json linguist-generated=true -diff
poetry.lock       linguist-generated=true -diff
uv.lock           linguist-generated=true -diff
